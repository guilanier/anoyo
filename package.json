{
    "name": "anoyo-website",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "NODE_ENV=production vite build && cp dist/index.html dist/404.html",
        "compress:images": "resn compression:img",
        "compress:video": "resn compression:video",
        "compress:video-posters": "resn poster:extract",
        "deploy": "gh-pages -d dist",
        "deps:clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && pnpm store prune && rm -rf pnpm-lock.yaml && pnpm i",
        "dev": "vite",
        "preview": "vite preview"
    },
    "dependencies": {
        "@resn/cli": "^1.10.0",
        "@resn/compression-tools": "^2.5.3",
        "@resn/gozer-animation": "^1.8.20",
        "@resn/gozer-canvas": "^3.0.12",
        "@resn/gozer-color": "^3.0.4",
        "@resn/gozer-env": "^3.2.2",
        "@resn/gozer-glsl": "^6.1.2",
        "@resn/gozer-loading": "^6.11.1",
        "@resn/gozer-math": "^3.4.1",
        "@resn/gozer-styles": "^4.0.2",
        "@resn/gozer-three": "^5.8.1",
        "@resn/gozer-vue": "^5.23.2",
        "@tweakpane/plugin-essentials": "^0.2.1",
        "@vueuse/core": "^14.2.1",
        "eventemitter3": "^5.0.4",
        "gsap": "^3.14.2",
        "lenis": "^1.3.18",
        "postprocessing": "^6.38.3",
        "three": "^0.183.2",
        "tweakpane": "^4.0.5",
        "vite-plugin-glsl": "^1.5.6",
        "vue": "^3.5.30",
        "vue-router": "^5.0.3"
    },
    "devDependencies": {
        "@resn/eslint-plugin": "^2.2.3",
        "@resn/prettier-config": "^2.1.4",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vitejs/plugin-vue-jsx": "^5.1.5",
        "eslint": "^10.0.3",
        "eslint-plugin-vue": "^10.8.0",
        "gh-pages": "^6.3.0",
        "prettier": "^3.8.1",
        "sass": "^1.98.0",
        "vite": "^8.0.0"
    },
    "pnpm": {
        "overrides": {
          "three": "^0.183.2"
        }
      }
}
