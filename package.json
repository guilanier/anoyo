{
    "name": "anoyo-website",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "NODE_ENV=production vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll",
        "deploy": "gh-pages -d dist --dotfiles",
        "compress:images": "resn compression:img",
        "compress:video": "resn compression:video",
        "compress:video-posters": "resn poster:extract",
        "deps:clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && pnpm store prune && rm -rf pnpm-lock.yaml && pnpm i",
        "dev": "vite",
        "preview": "vite preview"
    },
    "dependencies": {
        "@resn/cli": "^1.11.0",
        "@resn/compression-tools": "^2.7.0",
        "@resn/gozer-animation": "^1.8.21",
        "@resn/gozer-canvas": "^3.0.13",
        "@resn/gozer-color": "^3.0.5",
        "@resn/gozer-env": "^3.2.3",
        "@resn/gozer-glsl": "^6.1.3",
        "@resn/gozer-loading": "^6.11.7",
        "@resn/gozer-math": "^3.4.2",
        "@resn/gozer-styles": "^4.0.2",
        "@resn/gozer-three": "^5.16.1",
        "@resn/gozer-vue": "^5.24.1",
        "@tweakpane/plugin-essentials": "^0.2.1",
        "@vueuse/core": "^15.0.0",
        "eventemitter3": "^5.0.4",
        "gsap": "^3.15.0",
        "lenis": "^1.3.26",
        "postprocessing": "^6.39.5",
        "three": "^0.186.0",
        "tweakpane": "^4.0.5",
        "vite-plugin-glsl": "^1.6.1",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@resn/eslint-plugin": "^2.2.3",
        "@resn/prettier-config": "^2.1.4",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitejs/plugin-vue-jsx": "^5.1.6",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.0",
        "gh-pages": "^6.3.0",
        "prettier": "^3.9.9",
        "sass": "^1.105.0",
        "vite": "^8.3.0"
    },
    "pnpm": {
        "overrides": {
            "three": "^0.186.0"
        }
    }
}
