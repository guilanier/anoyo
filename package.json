{
    "name": "vite-template",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "compress:images": "resn compression:img",
        "compress:video": "resn compression:video",
        "compress:video-posters": "resn poster:extract",
        "deploy": "gh-pages -d dist",
        "dev": "vite",
        "preview": "vite preview",
        "build": "NODE_ENV=production vite build && cp dist/index.html dist/404.html",
        "deps:clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && pnpm store prune && rm -rf pnpm-lock.yaml && pnpm i"
    },
    "dependencies": {
        "@resn/cli": "^1.8.6",
        "@resn/compression-tools": "^2.3.0",
        "@resn/gozer-animation": "^1.8.19",
        "@resn/gozer-canvas": "^3.0.11",
        "@resn/gozer-color": "^3.0.3",
        "@resn/gozer-env": "^3.2.1",
        "@resn/gozer-glsl": "^6.0.5",
        "@resn/gozer-loading": "^6.11.0",
        "@resn/gozer-math": "^3.3.8",
        "@resn/gozer-styles": "^4.0.0",
        "@resn/gozer-three": "^5.7.0",
        "@resn/gozer-vue": "^5.12.2",
        "@resn/gsap": "^1.1.0",
        "@tweakpane/plugin-essentials": "^0.2.1",
        "@vueuse/core": "^13.1.0",
        "eventemitter3": "^5.0.1",
        "lenis": "^1.0.42",
        "postprocessing": "^6.37.2",
        "three": "^0.175.0",
        "tweakpane": "^4.0.5",
        "vite-plugin-glsl": "^1.4.0",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@resn/eslint-plugin": "^2.2.2",
        "@resn/prettier-config": "^2.1.3",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vitejs/plugin-vue-jsx": "^4.1.2",
        "eslint": "^9.24.0",
        "eslint-plugin-vue": "^10.0.0",
        "gh-pages": "^6.3.0",
        "prettier": "^3.3.3",
        "sass": "^1.86.3",
        "vite": "^6.2.6"
    }
}
